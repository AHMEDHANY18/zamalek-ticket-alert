# Copy this file to .env and fill in your real values.

# Get this from @BotFather on Telegram after creating a new bot.
TELEGRAM_BOT_TOKEN=123456789:AAEXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Your personal chat ID — get it from @userinfobot or @RawDataBot
# Send any message to your bot first, then ask one of those bots
# for your numeric ID.
TELEGRAM_CHAT_ID=123456789

# How often (in seconds) to check tazkarti.com. 60 = every minute.
POLL_INTERVAL_SECONDS=60
