# Copy this file to .env and fill in your real values.

# Get this from @BotFather on Telegram after creating a new bot.
TELEGRAM_BOT_TOKEN=123456789:AAEXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Your personal chat ID — get it from @userinfobot or @RawDataBot
# Send any message to your bot first, then ask one of those bots
# for your numeric ID.
TELEGRAM_CHAT_ID=123456789

# How often (in seconds) to poll tazkarti.com. 20 = three checks per minute.
# Lower = better chance to catch brief availability windows; too low risks
# rate-limiting by tazkarti. The bot only broadcasts when a sold-out
# category transitions to available, so faster polling = faster alerts.
POLL_INTERVAL_SECONDS=20
